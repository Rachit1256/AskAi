# --- secrets -----------------------------------------------------------------
# Never commit these. .env.example is committed, so it must contain only
# placeholders -- never a real key.
.env
.env.*
!.env.example

# --- python ------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- data (runtime, never source) --------------------------------------------
backend/var/
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.parquet

# --- node --------------------------------------------------------------------
node_modules/
dist/
.vite/
npm-debug.log*

# --- editors / os ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
